@{
    ViewData["Title"] = "Spatial Analytics Dashboard";
    Layout = null;
}

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    
    <link href="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.css" rel="stylesheet" />
    <!-- CSS Utama & CSS Panel -->
    <link rel="stylesheet" href="~/css/map.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/panel.css" asp-append-version="true" />
</head>
<body>

    <!-- Peta Fullscreen -->
    <div id="map"></div>

    <!-- Panel Filter Sebelah Kanan (Melayang) -->
    <div class="filter-sidebar">
        <h3>Spatial Filter</h3>

        <!-- Filter Dropdown Kota / Kabupaten -->
        <div class="filter-group">
            <label for="filter-city">Kota / Kabupaten</label>
            <select id="filter-city" class="filter-control">
                <option value="all">Semua Wilayah</option>
                <option value="Surabaya">Kota Surabaya</option>
                <option value="Sidoarjo">Kab. Sidoarjo</option>
            </select>
        </div>

        <!-- Filter Dropdown Variabel Data (Choropleth) -->
        <div class="filter-group">
            <label for="filter-metric">Tampilkan Berdasarkan</label>
            <select id="filter-metric" class="filter-control">
                <option value="total_penduduk">Total Penduduk</option>
                <option value="pria">Jumlah Laki-laki</option>
                <option value="wanita">Jumlah Perempuan</option>
            </select>
        </div>

        <!-- Slider Transparansi Warna Area -->
        <div class="filter-group">
            <label for="filter-opacity">Transparansi Area</label>
            <input type="range" id="filter-opacity" class="filter-control" min="0.1" max="1" step="0.1" value="0.7">
        </div>
    </div>
    <!-- Library Scripts -->
    <script src="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@turf/turf@6/turf.min.js"></script>

    <!-- App Scripts (Urutan Harus Map.js Dulu, Baru Filter.js) -->
    <script src="~/js/map.js" asp-append-version="true"></script>
    <script src="~/js/filter.js" asp-append-version="true"></script>
</body>
</html>