@{
    ViewData["Title"] = "Spatial Analytics Dashboard";
    Layout = null;
}
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    
    <!-- MapLibre GL CSS -->
    <link href="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.css" rel="stylesheet" />
    
    <!-- CSS Utama & CSS Panel -->
    <link rel="stylesheet" href="~/css/map.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/panel.css" asp-append-version="true" />
</head>
<body>

    <!-- Peta Fullscreen -->
    <div id="map"></div>

    <!-- Panel Filter Sebelah Kanan (Melayang) -->
    <div class="filter-sidebar">
        <h3>Filter Wilayah</h3>

        <!-- Filter Dropdown Kota / Kabupaten -->
        <div class="filter-group">
            <label for="filter-city">Kabupaten / Kota</label>
            <select id="filter-city" class="filter-control">
                <option value="all">Semua Kota / Kabupaten</option>
                <!-- Opsi kota dimuat dinamis lewat API .NET oleh filter.js -->
            </select>
        </div>

        <!-- Filter Dropdown Kecamatan (Dinamis & Disabled di Awal) -->
        <div class="filter-group">
            <label for="filter-district">Kecamatan</label>
            <select id="filter-district" class="filter-control" disabled>
                <option value="all">Semua Kecamatan</option>
                <!-- Opsi kecamatan dimuat dinamis saat kota dipilih -->
            </select>
        </div>
    </div>

    <!-- Library Scripts -->
    <script src="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.js"></script>

    <!-- App Scripts (Urutan Harus map.js Dulu, Baru filter.js) -->
    <script src="~/js/map.js" asp-append-version="true"></script>
    <script src="~/js/filter.js" asp-append-version="true"></script>
</body>
</html>